#!/usr/bin/env python3
"""
RL Agents Module

Implements Policy Iteration and Value Iteration agents for grid-world environments.
"""

import numpy as np


class PolicyIterationAgent:
    """
    Implements Policy Iteration for a given environment.
    
    Attributes:
        max_iterations (int): Maximum number of iterations before asking user to continue
        timeout_seconds (float): Maximum time in seconds before asking user to continue
    """

    def __init__(self, env, gamma=0.9, theta=1e-6, max_iterations=10000, timeout_seconds=300):
        self.env = env
        self.gamma = gamma
        self.theta = theta
        self.max_iterations = max_iterations
        self.timeout_seconds = timeout_seconds
        # Initialize all states including terminal states
        self.V = {s: 0.0 for s in env.states}
        self.V.update({s: 0.0 for s in env.terminal_states})
        self.policy = {s: np.random.choice(env.actions) for s in env.states}

    def policy_evaluation(self):
        """Evaluate the current policy until convergence."""
        import time
        start_time = time.time()
        
        while True:
            delta = 0.0
            for s in self.env.states:
                # Skip terminal states - they have value 0 and are absorbing
                if s in self.env.terminal_states:
                    self.V[s] = 0.0
                    continue
                v = self.V[s]
                action = self.policy[s]
                next_state, reward, _ = self.env.step(s, action)
                self.V[s] = reward + self.gamma * self.V[next_state]
                delta = max(delta, abs(v - self.V[s]))
            if delta < self.theta:
                print(f"Policy evaluation converged (delta = {delta:.6f})")
                return True
            
            elapsed = time.time() - start_time
            if elapsed > self.timeout_seconds:
                print(f"\nPolicy evaluation timed out after {elapsed:.2f}s (max {self.timeout_seconds}s)")
                return self._ask_user_continuation("policy_evaluation", 0, elapsed)
            
            import sys
            if not hasattr(self, '_eval_iteration'):
                self._eval_iteration = 0
            self._eval_iteration += 1
            
            if self._eval_iteration >= self.max_iterations:
                print(f"\nPolicy evaluation reached maximum iterations ({self.max_iterations})")
                return self._ask_user_continuation("policy_evaluation", self._eval_iteration, elapsed)
            
            if self._eval_iteration % 100 == 0:
                print(f"Policy evaluation iteration {self._eval_iteration}, delta = {delta:.6f}, elapsed = {elapsed:.2f}s")

    def policy_improvement(self):
        """Improve the policy greedily w.r.t. the current value function."""
        import time
        start_time = time.time()
        
        while True:
            policy_stable = True
            # Define action priority (Up > Left > Down > Right)
            action_priority = {'up': 0, 'left': 1, 'down': 2, 'right': 3}
            
            for s in self.env.states:
                if s in self.env.terminal_states:
                    continue
                old_action = self.policy[s]
                action_values = {}
                for a in self.env.actions:
                    next_state, reward, _ = self.env.step(s, a)
                    # Handle terminal states - they have value 0
                    next_value = self.V.get(next_state, 0.0)
                    action_values[a] = reward + self.gamma * next_value
                
                # Find maximum value
                max_value = max(action_values.values())
                
                # Get all actions with maximum value and select based on priority
                best_actions = [a for a, v in action_values.items() if abs(v - max_value) < 1e-10]
                best_action = min(best_actions, key=lambda a: action_priority[a])
                
                self.policy[s] = best_action
                if best_action != old_action:
                    policy_stable = False
            
            if policy_stable:
                print(f"Policy improvement converged")
                return True
            
            elapsed = time.time() - start_time
            if elapsed > self.timeout_seconds:
                print(f"\nPolicy improvement timed out after {elapsed:.2f}s (max {self.timeout_seconds}s)")
                return self._ask_user_continuation("policy_improvement", 0, elapsed)
            
            import sys
            if not hasattr(self, '_imp_iteration'):
                self._imp_iteration = 0
            self._imp_iteration += 1
            
            if self._imp_iteration >= self.max_iterations:
                print(f"\nPolicy improvement reached maximum iterations ({self.max_iterations})")
                return self._ask_user_continuation("policy_improvement", self._imp_iteration, elapsed)
            
            if self._imp_iteration % 100 == 0:
                print(f"Policy improvement iteration {self._imp_iteration}, elapsed = {elapsed:.2f}s")

    def run(self):
        """Execute the full policy iteration algorithm."""
        import time
        start_time = time.time()
        
        while True:
            print(f"Policy Iteration - Policy Evaluation")
            eval_result = self.policy_evaluation()
            if not eval_result:
                return self.policy, self.V
            
            print(f"Policy Iteration - Policy Improvement")
            imp_result = self.policy_improvement()
            if not imp_result:
                return self.policy, self.V
            
            elapsed = time.time() - start_time
            if elapsed > self.timeout_seconds:
                print(f"\nPolicy iteration timed out after {elapsed:.2f}s (max {self.timeout_seconds}s)")
                return self._ask_user_continuation("policy_iteration", 0, elapsed)
            
            import sys
            if not hasattr(self, '_total_iteration'):
                self._total_iteration = 0
            self._total_iteration += 1
            
            if self._total_iteration >= self.max_iterations:
                print(f"\nPolicy iteration reached maximum iterations ({self.max_iterations})")
                return self._ask_user_continuation("policy_iteration", self._total_iteration, elapsed)
        
        return self.policy, self.V
    
    def _ask_user_continuation(self, algorithm_name, iterations, elapsed):
        """Ask user whether to continue or stop when limits are reached."""
        import sys
        print("\n" + "="*60)
        print(f"{algorithm_name} did not converge within limits.")
        print(f"Iterations: {iterations}, Elapsed time: {elapsed:.2f}s")
        print("="*60)
        
        while True:
            choice = input("Continue with current results? (y/n): ").strip().lower()
            if choice in ['y', 'yes']:
                print("Continuing with current results...")
                return False
            elif choice in ['n', 'no']:
                print("Stopping algorithm.")
                sys.exit(0)
            else:
                print("Please enter 'y' or 'n'.")
        """Ask user whether to continue or stop when limits are reached."""
        print("\n" + "="*60)
        print(f"{algorithm_name} did not converge within limits.")
        print(f"Iterations: {iterations}, Elapsed time: {elapsed:.2f}s")
        print("="*60)
        
        while True:
            choice = input("Continue with current results? (y/n): ").strip().lower()
            if choice in ['y', 'yes']:
                print("Continuing with current results...")
                return False
            elif choice in ['n', 'no']:
                print("Stopping algorithm.")
                sys.exit(0)
            else:
                print("Please enter 'y' or 'n'.")


class ValueIterationAgent:
    """
    Implements Value Iteration for a given environment.
    
    Attributes:
        max_iterations (int): Maximum number of iterations before asking user to continue
        timeout_seconds (float): Maximum time in seconds before asking user to continue
    """

    def __init__(self, env, gamma=0.9, theta=1e-6, max_iterations=10000, timeout_seconds=300):
        self.env = env
        self.gamma = gamma
        self.theta = theta
        self.max_iterations = max_iterations
        self.timeout_seconds = timeout_seconds
        # Initialize all states including terminal states
        self.V = {s: 0.0 for s in env.states}
        self.V.update({s: 0.0 for s in env.terminal_states})
        self.policy = {s: np.random.choice(env.actions) for s in env.states}

    def run(self):
        """Execute the full value iteration algorithm."""
        import time
        start_time = time.time()
        
        while True:
            delta = 0.0
            for s in self.env.states:
                if s in self.env.terminal_states:
                    self.V[s] = 0.0
                    continue
                action_values = []
                for a in self.env.actions:
                    next_state, reward, _ = self.env.step(s, a)
                    # Handle terminal states - they have value 0
                    next_value = self.V.get(next_state, 0.0)
                    action_values.append(reward + self.gamma * next_value)
                max_value = max(action_values)
                delta = max(delta, abs(self.V[s] - max_value))
                self.V[s] = max_value
            if delta < self.theta:
                print(f"Value iteration converged (delta = {delta:.6f})")
                break
            
            elapsed = time.time() - start_time
            if elapsed > self.timeout_seconds:
                print(f"\nValue iteration timed out after {elapsed:.2f}s (max {self.timeout_seconds}s)")
                return self._ask_user_continuation("value_iteration", 0, elapsed)
            
            import sys
            if not hasattr(self, '_vi_iteration'):
                self._vi_iteration = 0
            self._vi_iteration += 1
            
            if self._vi_iteration >= self.max_iterations:
                print(f"\nValue iteration reached maximum iterations ({self.max_iterations})")
                return self._ask_user_continuation("value_iteration", self._vi_iteration, elapsed)
            
            if self._vi_iteration % 100 == 0:
                print(f"Value iteration iteration {self._vi_iteration}, delta = {delta:.6f}, elapsed = {elapsed:.2f}s")

        # Derive greedy policy
        # Define action priority (Up > Left > Down > Right)
        action_priority = {'up': 0, 'left': 1, 'down': 2, 'right': 3}
        
        for s in self.env.states:
            if s in self.env.terminal_states:
                continue
            action_values = {}
            for a in self.env.actions:
                next_state, reward, _ = self.env.step(s, a)
                # Handle terminal states - they have value 0
                next_value = self.V.get(next_state, 0.0)
                action_values[a] = reward + self.gamma * next_value
            
            # Find maximum value
            max_value = max(action_values.values())
            
            # Get all actions with maximum value and select based on priority
            best_actions = [a for a, v in action_values.items() if abs(v - max_value) < 1e-10]
            best_action = min(best_actions, key=lambda a: action_priority[a])
            self.policy[s] = best_action

        return self.policy, self.V
